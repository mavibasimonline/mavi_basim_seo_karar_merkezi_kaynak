{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mavi-basim-seo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "seo", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "vars": { "SITE_ORIGIN": "https://mavibasim.com", "GSC_PROPERTY": "https://mavibasim.com/", "CRAWL_ENABLED": "false", "AUTOMATION_ENABLED": "false", "ENABLE_GOOGLE_ADS": "false" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": false }
}
