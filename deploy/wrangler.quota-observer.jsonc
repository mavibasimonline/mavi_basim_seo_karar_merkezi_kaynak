{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mavi-basim-quota-observer",
  "main": "../src/quota-observer.ts",
  "compatibility_date": "2026-10-01",
  "services": [{"binding": "APP_HEALTH", "service": "mavi-basim-seo-prod"}],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "mavi-basim-seo",
    "database_id": "18f8c90d-4af1-430c-ac86-ddf184c75a0b"
  }],
  "vars": {"QUOTA_OBSERVER_ENABLED": "false", "CLOUDFLARE_ACCOUNT_ID": ""},
  "triggers": {"crons": ["2,17,32,47 * * * *"]},
  "version_metadata": {"binding": "CF_VERSION_METADATA"},
  "observability": {"enabled": true}
}
