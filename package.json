{
  "name": "mavi-basim-seo-karar-merkezi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs wrangler dev --local --ip 127.0.0.1 --port 8787",
    "build": "node scripts/run.mjs wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "test": "node scripts/run.mjs vitest run",
    "test:e2e": "node scripts/run.mjs playwright test",
    "test:import": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "db:migrate": "node scripts/run.mjs wrangler d1 migrations apply seo --local",
    "data:prepare": "python3 scripts/import_keywords.py --output .local/keywords.sql --report .local/source-audit.json",
    "data:import": "npm run data:prepare && node scripts/run.mjs --capture .local/import.log wrangler d1 execute seo --local --file .local/keywords.sql",
    "check": "npm run typecheck && npm test && npm run test:import && npm run build"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "robots-parser": "3.0.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261023.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "wrangler": "4.152.0"
  }
}
