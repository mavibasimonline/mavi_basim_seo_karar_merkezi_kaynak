# Yerel kullanım: değerleri .dev.vars içine güvenli şekilde yazın; bu dosyayı commit etmeyin.
ADMIN_TOKEN=
# 32 rastgele baytın base64 karşılığı; OAuth token şifrelemesi için gereklidir.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/oauth/google/callback
GSC_PROPERTY=https://mavibasim.com/
# Yalnızca sayısal GA4 property ID; boşsa GA4 işi çalışmaz.
GA4_PROPERTY_ID=
# Kabul ön koşulları doğrulanana kadar kapalı kalır; yalnızca tam "true" açar.
AUTOMATION_ENABLED=false
# Ads tamamen opsiyonel. Onaylı developer token / müşteri / OAuth kapsamı gerekir.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=
ENABLE_GOOGLE_ADS=false
